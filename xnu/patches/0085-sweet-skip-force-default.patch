--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -511,10 +511,14 @@
 	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
 	    touch_rd(st.se, 0x908));
 	/*
-	 * Joyeuse ABL leaves M_CMD_DONE enabled at SE+0x64 while the SE is
-	 * idle; the busy check below catches an SE in active use.
+	 * SE+0x64 is GENI_IF_DISABLE_RO (not an IRQ mask): bit0 set means the
+	 * FIFO interface is disabled and the SE runs in DMA/GPI mode.  Print
+	 * the mode registers so a boot photo shows which path ABL left us on.
 	 */
-	printf("SWEET TOUCH: se7 mirqen=%#x\n", touch_rd(st.se, 0x64));
+	printf("SWEET TOUCH: se7 if_dis=%#x clk_ctrl=%#x dma_en=%#x "
+	    "dma_if=%#x fifo_if_dis=%#x\n",
+	    touch_rd(st.se, 0x64), touch_rd(st.se, 0x60), touch_rd(st.se, SE_DMA),
+	    touch_rd(st.se, 0x2004), touch_rd(st.se, 0x2008));
 	if (((fw >> 8) & 0xffu) != 3u ||
 	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
 	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
@@ -534,7 +538,13 @@
 	se_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
 	se_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
 	se_wr(st.se, 0x24, 0x7f);
-	se_wr(st.se, 0x20, 1);
+	/*
+	 * GENI_FORCE_DEFAULT_REG (FORCE_DEFAULT): Linux writes this to put
+	 * default values on the GENI output pads, but on Atoll SE7 the write
+	 * itself wedges the chip (0084: last traced line was this store).
+	 * ABL has already configured the pads, so skip it.
+	 */
+	printf("SWEET TOUCH: skip force_default (0x20)\n");
 	se_wr(st.se, SE_CLK_SEL, 0);
 	se_wr(st.se, SE_MCLK, (7u << 4) | 1u);
 	se_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
