+/* Trace every SE7 register write during bring-up: the last printed
+ * offset before the console stops is the one that hangs the bus. */
+static void
+se_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	printf("SWEET TOUCH: se_wr %#x=%#x\n", off, val);
+	touch_wr(base, off, val);
+}
+
 static bool
 touch_se_init(void)
 {
