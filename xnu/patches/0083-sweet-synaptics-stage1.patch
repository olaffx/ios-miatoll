+static bool
+touch_is_miatoll(void)
+{
+	DTEntry root;
+	const char *compat;
+	unsigned long size;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (void const **)&compat, &size)
+	        != kSuccess || !compat) {
+		return false;
+	}
+	for (const char *s = compat; *s; s += strlen(s) + 1) {
+		if (!strcmp(s, "xiaomi,miatoll")) {
+			return true;
+		}
+	}
+	return false;
+}
