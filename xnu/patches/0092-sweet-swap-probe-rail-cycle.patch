+int
+sweet_rpmh_vreg_off(const char *res)
+{
+	/* Same whitelist and nominal voltage; only the enable vote flips. */
+	unsigned mv = strcmp(res, "ldoc11") == 0 ? 3200u
+	    : strcmp(res, "ldoa10") == 0 ? 1800u
+	    : strcmp(res, "ldoc7") == 0 ? 3000u : 0u;
+	if (!mv) {
+		printf("SWEET RPMH: off: unknown resource\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv, 0);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: off failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
