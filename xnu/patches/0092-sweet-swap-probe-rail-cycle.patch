+/* Hold SDA driven high while clocking 16 times: frees a slave that is
+ * waiting for SDA to go high inside a byte. Then release both lines. */
+static void
+bb_bus_free(void)
+{
+	touch_gpio_mi(st.bb_sda, 0, 3, 3, true, true); /* latch high, OE on */
+	for (unsigned i = 0; i < 16; ++i) {
+		bb_scl_high();
+		bb_scl_low();
+	}
+	bb_oe(st.bb_sda, false);
+	touch_gpio_mi(st.bb_sda, 0, 3, 0, true, false); /* back to input latch-low */
+	delay(BB_HALF);
+}
