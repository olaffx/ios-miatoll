+/* One line per cmd-db resource: name, vote address, slave. */
+void
+sweet_rpmh_db_dump(void)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (rh_map()) {
+		goto out;
+	}
+	for (unsigned i = 0; ; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY)) {
+			break;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			char name[9] = {0};
+			for (unsigned k = 0; k < 8; ++k) {
+				name[k] = (char)(rh_read(rh_db, e + 4u * (k / 4)) >>
+				    (8u * (k % 4)) & 0xffu);
+			}
+			printf("SWEET RPMH: db %s addr=%#x slave=%u\n",
+			    name, rh_read(rh_db, e + 16), slave);
+		}
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
