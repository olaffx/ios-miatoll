+/* Same contract as touch_msg_run: write XOR read, ≤3 TX, ≤90 RX. */
+static int
+touch_msg_bb(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	/* STOP ends each phase; touch_read's stretched pointer write is
+	 * unnecessary for TCM (plain reads, Linux syna_tcm_i2c_read). */
+	(void)stretch;
+	bb_recover();
+	bb_start();
+	if (!bb_write_byte((uint8_t)((addr << 1) | (nr ? 1u : 0u)))) {
+		bb_stop();
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < nt; ++i) {
+		if (!bb_write_byte(tx[i])) {
+			bb_stop();
+			return EIO;
+		}
+	}
+	for (unsigned i = 0; i < nr; ++i) {
+		rx[i] = bb_read_byte(i + 1u == nr);
+	}
+	bb_stop();
+	st.sent = nt;
+	st.got = nr;
+	return 0;
+}
