+/* ---- Software I2C on TLMM gpio6/7 (miatoll) ----
+ * Atoll's SE7 is ABL-loaded in GPI mode (GENI_IF_DISABLE_RO bit0 set) and
+ * every attempt to re-route the core wedges the bus: 0x20 (0084), 0x48
+ * (0086), 0x2004 (0088), 0x2008 (0089). Linux never flips those at runtime
+ * either — they belong to firmware load. So bit-bang the wire instead:
+ * every TLMM register used here is already exercised by the reset/IRQ
+ * code, and a bad transfer yields an error code, not a frozen SoC.
+ * Open-drain is emulated with the TLMM output-enable: drive low = OE on
+ * (output latch pinned to 0), release = OE off, pull-up holds the line. */
+#define BB_HALF   4   /* µs per phase ≈ 80 kHz (standard/fast-mode timing) */
+
+static void
+bb_oe(unsigned pin, bool on)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	touch_wr(st.gpio, off, on ? (cfg | 0x200u) : (cfg & ~0x200u));
+}
+
+static bool
+bb_level(unsigned pin)
+{
+	return (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u) != 0;
+}
+
+static void
+bb_sda_low(void)
+{
+	bb_oe(6, true);
+	delay(BB_HALF);
+}
+
+static void
+bb_sda_high(void)
+{
+	bb_oe(6, false);
+	delay(BB_HALF);
+}
+
+static void
+bb_scl_low(void)
+{
+	bb_oe(7, true);
+	delay(BB_HALF);
+}
+
+static void
+bb_scl_high(void)
+{
+	bb_oe(7, false);
+	for (unsigned i = 0; i < 1000 && !bb_level(7); ++i) {
+		delay(1); /* bounded slave clock stretching */
+	}
+	delay(BB_HALF);
+}
+
+static void
+bb_start(void)
+{
+	bb_sda_high();
+	bb_scl_high();
+	bb_sda_low();
+	bb_scl_low();
+}
+
+static void
+bb_stop(void)
+{
+	bb_sda_low();
+	bb_scl_high();
+	bb_sda_high();
+}
+
+/* true = ACK (slave pulled SDA low in the ninth clock). */
+static bool
+bb_write_byte(uint8_t b)
+{
+	for (int i = 7; i >= 0; --i) {
+		if (b & (1u << i)) {
+			bb_sda_high();
+		} else {
+			bb_sda_low();
+		}
+		bb_scl_high();
+		bb_scl_low();
+	}
+	bb_sda_high(); /* release SDA for the ACK slot */
+	bb_scl_high();
+	bool ack = !bb_level(6);
+	bb_scl_low();
+	return ack;
+}
+
+static uint8_t
+bb_read_byte(bool last)
+{
+	uint8_t b = 0;
+	for (int i = 7; i >= 0; --i) {
+		b <<= 1;
+		bb_scl_high();
+		if (bb_level(6)) {
+			b |= 1u;
+		}
+		bb_scl_low();
+	}
+	if (last) {
+		bb_sda_high(); /* NACK the final byte */
+	} else {
+		bb_sda_low();  /* ACK */
+	}
+	bb_scl_high();
+	bb_scl_low();
+	bb_sda_high();
+	return b;
+}
+
+/* A slave wedged mid-transfer holds SDA low: clock it out, then STOP. */
+static void
+bb_recover(void)
+{
+	if (bb_level(6)) {
+		return;
+	}
+	printf("SWEET TOUCH: bitbang SDA low before start; recovering\n");
+	for (unsigned i = 0; i < 9 && !bb_level(6); ++i) {
+		bb_scl_high();
+		bb_scl_low();
+	}
+	bb_stop();
+	if (!bb_level(6)) {
+		printf("SWEET TOUCH: bitbang SDA still low after recovery\n");
+	}
+}
