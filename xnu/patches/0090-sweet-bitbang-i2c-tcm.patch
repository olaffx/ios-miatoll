+/* ---- Synaptics TCM (miatoll, synaptics,tcm-i2c @0x20) ---- */
+
+static void
+tcm_take_id(const uint8_t *p, unsigned len)
+{
+	unsigned n = len < sizeof(st.tcm_id) ? len : (unsigned)sizeof(st.tcm_id);
+	memcpy(st.tcm_id, p, n);
+	st.tcm_have_id = true;
+	st.tcm_mode = n > 1 ? p[1] : 0;
+}
+
+/* TCM reads are plain: no register address write, no stretch (Linux i2c). */
+static int
+tcm_raw_read(uint8_t *buf, unsigned len)
+{
+	return touch_msg(TCM_ADDR, NULL, 0, buf, len, false);
+}
+
+static int
+tcm_raw_write(const uint8_t *tx, unsigned nt)
+{
+	return touch_msg(TCM_ADDR, tx, nt, NULL, 0, false);
+}
+
+/*
+ * Read one TCM message (4-byte header, payload, 0x5a padding) when the
+ * level IRQ is low. ENOENT means "no message pending" (IDLE/BUSY headers,
+ * bad marker or IRQ high); the stream stays synced either way.
+ */
+static int
+tcm_read_message(uint8_t *code, unsigned *plen)
+{
+	if (!st.poll_any && (touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u)) {
+		return ENOENT;
+	}
+	uint8_t hdr[4];
+	int err = tcm_raw_read(hdr, 4);
+	if (err) {
+		return err;
+	}
+	if (hdr[0] != TCM_MARKER) {
+		if (st.tcm_bad_hdr < 8) {
+			++st.tcm_bad_hdr;
+			printf("SWEET TOUCH: tcm header marker=%#x code=%#x\n",
+			    hdr[0], hdr[1]);
+		}
+		return ENOENT;
+	}
+	*code = hdr[1];
+	unsigned n = (unsigned)hdr[2] | ((unsigned)hdr[3] << 8);
+	if (*code == 0 || *code == 2 || *code == 3 || *code == 0xffu) {
+		/* IDLE/BUSY/CONTINUED_READ/INVALID carry no payload. */
+		*plen = 0;
+		return ENOENT;
+	}
+	if (n > sizeof(tcm_buf) - 1) {
+		/* Consume the bytes to keep the stream aligned, then fail. */
+		uint8_t junk[90];
+		unsigned left = n + 1;
+		while (left) {
+			unsigned chunk = left > sizeof(junk) ? (unsigned)sizeof(junk) : left;
+			err = tcm_raw_read(junk, chunk);
+			if (err) {
+				return err;
+			}
+			left -= chunk;
+		}
+		*plen = n;
+		return EMSGSIZE;
+	}
+	unsigned left = n + 1, off = 0;
+	while (left) {
+		unsigned chunk = left > 90 ? 90u : left;
+		err = tcm_raw_read(tcm_buf + off, chunk);
+		if (err) {
+			return err;
+		}
+		off += chunk;
+		left -= chunk;
+	}
+	if (tcm_buf[n] != TCM_PADDING) {
+		printf("SWEET TOUCH: tcm padding=%#x len=%u\n", tcm_buf[n], n);
+		return EIO;
+	}
+	*plen = n;
+	return 0;
+}
+
+/* Send [cmd,0,0] and wait up to ~3 s for its status response. */
+static int
+tcm_command(uint8_t cmd, uint8_t *resp, unsigned *rlen, unsigned max)
+{
+	const uint8_t tx[3] = {cmd, 0, 0};
+	int err = tcm_raw_write(tx, sizeof(tx));
+	if (err) {
+		printf("SWEET TOUCH: tcm cmd %#x write err=%d\n", cmd, err);
+		return err;
+	}
+	for (unsigned t = 0; t < 1500; ++t) {
+		uint8_t code = 0;
+		unsigned plen = 0;
+		err = tcm_read_message(&code, &plen);
+		if (err == ENOENT) {
+			touch_wait(2);
+			continue;
+		}
+		if (err) {
+			return err;
+		}
+		if (code == TCM_RPT_IDENTIFY) {
+			tcm_take_id(tcm_buf, plen);
+			continue;
+		}
+		if (code <= 0x0fu) {
+			if (code != TCM_STATUS_OK) {
+				printf("SWEET TOUCH: tcm cmd %#x status=%#x err=%u\n",
+				    cmd, code, plen ? tcm_buf[0] : 0);
+				return EIO;
+			}
+			unsigned n = plen < max ? plen : max;
+			memcpy(resp, tcm_buf, n);
+			*rlen = n;
+			if (cmd == TCM_CMD_IDENTIFY) {
+				tcm_take_id(tcm_buf, plen);
+			}
+			return 0;
+		}
+		/* Touch/other reports during a command wait are dropped. */
+	}
+	printf("SWEET TOUCH: tcm cmd %#x timed out\n", cmd);
+	return ETIMEDOUT;
+}
+
+/* Read whatever the reset produced until the line stays quiet. */
+static void
+tcm_drain(unsigned quiet_ms)
+{
+	unsigned waited = 0;
+	for (unsigned n = 0; n < 64; ++n) {
+		uint8_t code = 0;
+		unsigned plen = 0;
+		int err = tcm_read_message(&code, &plen);
+		if (err == 0) {
+			if (code == TCM_RPT_IDENTIFY) {
+				tcm_take_id(tcm_buf, plen);
+			}
+			waited = 0;
+			continue;
+		}
+		if (err != ENOENT) {
+			return;
+		}
+		if (waited >= quiet_ms) {
+			return;
+		}
+		touch_wait(2);
+		waited += 2;
+	}
+}
+
+/* LSB-first bit reader over the touch report (Linux touch_get_report_data). */
+static unsigned
+tcm_bits(const uint8_t *rep, unsigned rlen, unsigned offset, unsigned bits)
+{
+	unsigned out = 0, remain = bits, byte_off = offset / 8;
+	unsigned bit_off = offset % 8;
+
+	if (bits == 0 || bits > 32 || offset + bits > rlen * 8) {
+		return 0;
+	}
+	while (remain) {
+		unsigned byte = rep[byte_off] >> bit_off;
+		unsigned avail = 8 - bit_off;
+		unsigned take = remain < avail ? remain : avail;
+		out |= (byte & ((1u << take) - 1u)) << (bits - remain);
+		bit_off = 0;
+		++byte_off;
+		remain -= take;
+	}
+	return out;
+}
+
+/*
+ * Walk st.tcm_cfg over one touch report (Linux touch_parse_report), then map
+ * FINGER/GLOVED objects to panel pixels for sweet_hid_touch.
+ */
+static int
+tcm_parse_touch(const uint8_t *rep, unsigned rlen, uint32_t *pmask, int *px, int *py)
+{
+	uint8_t status[TOUCH_MAX];
+	unsigned rawx[TOUCH_MAX], rawy[TOUCH_MAX];
+	const uint8_t *cfg = st.tcm_cfg;
+	unsigned idx = 0, offset = 0, obj = 0, next = 0;
+	unsigned active_count = 0, objects = 0, end_fe = 0, steps = 0;
+	bool active_only = false, have_num = false;
+
+	*pmask = 0;
+	memset(status, 0, sizeof(status));
+	memset(rawx, 0, sizeof(rawx));
+	memset(rawy, 0, sizeof(rawy));
+	if (!st.tcm_cfg_len || !rlen) {
+		return EINVAL;
+	}
+	while (idx < st.tcm_cfg_len) {
+		unsigned code = cfg[idx++];
+		if (++steps > 8192) {
+			return EINVAL;
+		}
+		switch (code) {
+		case TCF_END:
+			goto parsed;
+		case TCF_FOREACH_ACT:
+			obj = 0;
+			next = idx;
+			active_only = true;
+			break;
+		case TCF_FOREACH_OBJ:
+			obj = 0;
+			next = idx;
+			active_only = false;
+			break;
+		case TCF_FOREACH_END:
+			end_fe = idx;
+			if (active_only) {
+				if (have_num) {
+					++objects;
+					if (objects < active_count) {
+						idx = next;
+					}
+				} else if (offset < rlen * 8) {
+					idx = next;
+				}
+			} else {
+				++obj;
+				if (obj < st.tcm_max_objects) {
+					idx = next;
+				}
+			}
+			break;
+		case TCF_PAD_BYTE:
+			offset = (offset + 7u) & ~7u;
+			break;
+		case TCF_OBJ_INDEX:
+		case TCF_OBJ_STATUS:
+		case TCF_OBJ_X:
+		case TCF_OBJ_Y:
+		case TCF_NUM_ACTIVE: {
+			if (idx >= st.tcm_cfg_len) {
+				return EINVAL;
+			}
+			unsigned bits = cfg[idx++];
+			unsigned data;
+			if (bits == 0 || bits > 32) {
+				return EINVAL;
+			}
+			if (offset + bits > rlen * 8) {
+				/*
+				 * Trailing padding re-entered the foreach: stop with
+				 * the objects parsed so far instead of overwriting
+				 * them with zero reads.
+				 */
+				goto parsed;
+			}
+			data = tcm_bits(rep, rlen, offset, bits);
+			offset += bits;
+			if (code == TCF_OBJ_INDEX) {
+				if (data >= TOUCH_MAX || data >= st.tcm_max_objects) {
+					return EINVAL;
+				}
+				obj = data;
+			} else if (code == TCF_OBJ_STATUS) {
+				status[obj] = (uint8_t)data;
+			} else if (code == TCF_OBJ_X) {
+				rawx[obj] = data;
+			} else if (code == TCF_OBJ_Y) {
+				rawy[obj] = data;
+			} else {
+				have_num = true;
+				active_count = data;
+				if (active_count == 0) {
+					idx = end_fe;
+				}
+			}
+			break;
+		}
+		default:
+			if (idx >= st.tcm_cfg_len) {
+				return EINVAL;
+			}
+			/* Known codes carry one bit-length byte; unknown ones bail. */
+			if ((code >= TCF_TIMESTAMP && code <= 23) || code == 25 ||
+			    (code >= 0x80 && code <= 0x82)) {
+				unsigned bits = cfg[idx++];
+				if (bits == 0 || bits > 32) {
+					return EINVAL;
+				}
+				offset += bits;
+				break;
+			}
+			printf("SWEET TOUCH: tcm cfg unknown code=%#x\n", code);
+			return EINVAL;
+		}
+	}
+parsed:
+	for (unsigned i = 0; i < TOUCH_MAX && i < st.tcm_max_objects; ++i) {
+		if (status[i] != 1 && status[i] != 2) {
+			continue; /* LIFT and everything else: no contact */
+		}
+		if (!st.tcm_max_x || !st.tcm_max_y ||
+		    rawx[i] > st.tcm_max_x || rawy[i] > st.tcm_max_y) {
+			return EIO;
+		}
+		px[i] = (int)((uint64_t)rawx[i] * 1079u / st.tcm_max_x);
+		py[i] = (int)((uint64_t)rawy[i] * 2399u / st.tcm_max_y);
+		*pmask |= 1u << i;
+	}
+	return 0;
+}
+
+static int
+touch_synaptics(void)
+{
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	for (unsigned n = 0; n < 32; ++n) {
+		uint8_t code = 0;
+		unsigned plen = 0;
+		int err = tcm_read_message(&code, &plen);
+		if (err == ENOENT) {
+			break;
+		}
+		if (err) {
+			return err;
+		}
+		if (code == TCM_RPT_IDENTIFY) {
+			tcm_take_id(tcm_buf, plen);
+			printf("SWEET TOUCH: tcm re-identify mode=%#x\n", st.tcm_mode);
+			continue;
+		}
+		if (code == TCM_RPT_TOUCH) {
+			err = tcm_parse_touch(tcm_buf, plen, &mask, x, y);
+			if (err) {
+				return err;
+			}
+			touch_report(mask, x, y);
+			continue;
+		}
+		if (st.tcm_seen < 8) {
+			++st.tcm_seen;
+			printf("SWEET TOUCH: tcm report code=%#x len=%u ignored\n",
+			    code, plen);
+		}
+	}
+	return 0;
+}
