 /*
  * SWEET PM6150L L11C bring-up; see report.md for DT and source evidence.
  * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
- * 0094: active-set votes plus optional sleep-set votes (Linux qcom,set=0x03
- * votes both; sleep TCS occupy indices 2..4 of this DRV per DT tcs-config).
- * No wake programming, SPMI writes, GIC handler, or timeout recovery.
+ * 0095: active, sleep and wake-set votes. DT tcs-config puts them at
+ * TCS 0..1 / 2..4 / 5..7 of this DRV; 0094 proved sleep votes physically
+ * act while active votes acked but changed nothing, and Linux
+ * (rpmh-regulator.c) sends active values to the WAKE_ONLY state first
+ * whenever the sleep set differs. No SPMI writes, GIC handler or
+ * timeout recovery.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -26,6 +29,8 @@
 #define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
 #define RH_SLEEP_FIRST  2u       /* SLEEP occupies TCS 2..4 in this DRV */
 #define RH_SLEEP_N      3u
+#define RH_WAKE_FIRST   5u       /* WAKE occupies TCS 5..7 in this DRV */
+#define RH_WAKE_N       3u
 #define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
 #define RH_TCS_STRIDE   0x2a0u
 #define RH_CMD_STRIDE   0x14u
@@ -454,6 +459,47 @@
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
+}
+
+/*
+ * 0095: mirror the vote into the WAKE set (TCS 5..7 of this DRV). The wake
+ * set is what RPMh applies while the system is awake; rpmh-regulator.c
+ * sends active values there before the active-only state whenever the
+ * sleep set differs, and 0094 showed active-only votes alone never act.
+ */
+int
+sweet_rpmh_vreg_wake(const char *res, unsigned mv)
+{
+	int check = rh_vote_check(res, mv);
+	if (check) {
+		return check;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		int chosen = 0;
+		error = rh_select("WAKE", RH_WAKE_FIRST, RH_WAKE_N, address, &chosen);
+		if (!error) {
+			error = rh_fire((unsigned)chosen, "WAKE", address, mv, 1);
+		}
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: wake vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 
